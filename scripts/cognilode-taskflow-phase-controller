#!/usr/bin/env python3
"""Mechanical TaskFlow Steps 4-6 controller over the incumbent D1 job queue.

This module deliberately does not implement a scheduler or substantive scorer.
D1 remains the only job/lease/completion authority.  The historical rhythm remains
responsible for starting chatgpt.com phase jobs.  RPE/DecisionX remain upstream of
this transport.

Safety invariant: TaskFlow dependency edges target only each prerequisite step's
external_effect phase job.  Research and ChatGPT phase completion can therefore
never release a dependent TaskFlow step.
"""
from __future__ import annotations

from dataclasses import dataclass, field, replace
from datetime import UTC, datetime
from pathlib import Path, PurePosixPath
from typing import Any, Iterable, Mapping, Sequence
import argparse
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import zipfile

HERE = Path(__file__).resolve().parent
SENDER_PATH = HERE / "cognilode-b4pt0r-chatmode"
QUEUE_WORKER_PATH = HERE / "cognilode-chatmode-queue-worker"
SLACK_ROLES_PATH = HERE.parent / "config/employee-slack-roles.json"
DEFAULT_SECRETARY = Path.home() / "bin/modified-codex-secretary"
DEFAULT_STATE_ROOT = Path.home() / ".local/share/cognilode/taskflow-phase-controller"
MAX_ZIP_BYTES = 20 * 1024 * 1024
MAX_EXPANDED_BYTES = 100 * 1024 * 1024
MAX_ZIP_MEMBERS = 5000
HEX64 = re.compile(r"^[0-9a-f]{64}$")
STEP_RE = re.compile(r"^(?P<indent>\s*)\[(?P<check>[ xX])\]\s+(?P<id>[A-Za-z0-9_.-]+)\s+(?P<title>.+?)\s*$")
FIELD_RE = re.compile(r"^(?P<indent>\s+)(?P<key>[A-Za-z0-9_-]+):\s*(?P<value>.*)$")


def utc() -> str:
    return datetime.now(UTC).isoformat()


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def atomic_json(path: Path, value: Mapping[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, prefix=".receipt-", delete=False) as out:
        temp = Path(out.name)
        json.dump(value, out, indent=2, sort_keys=True)
        out.write("\n")
        out.flush()
        os.fsync(out.fileno())
    temp.replace(path)


def stable_id(*parts: str) -> str:
    raw = "\x1f".join(parts)
    return "tf-" + hashlib.sha256(raw.encode()).hexdigest()[:40]


def slack_role_context(employee: str) -> str:
    directory=json.loads(SLACK_ROLES_PATH.read_text(encoding="utf-8"))
    entry=(directory.get("employees") or {}).get(employee)
    if not isinstance(entry,dict) or not entry.get("role") or not entry.get("slack_message"):
        raise ValueError(f"Slack role missing for named employee: {employee}")
    return f"{employee} — {entry['role']} — {entry.get('org','')}\nSlack role source: {entry['slack_message']}"


@dataclass(frozen=True)
class Step:
    step_id: str
    title: str
    checked: bool
    indent: int
    fields: Mapping[str, str] = field(default_factory=dict)
    dependencies: tuple[str, ...] = ()


@dataclass(frozen=True)
class Plan:
    project_id: str
    project_name: str
    sha256: str
    text: str
    steps: tuple[Step, ...]
    source_ref: str = ""
    inflight_revisions: Mapping[str, str] = field(default_factory=dict)
    completed_effects: Mapping[str, str] = field(default_factory=dict)
    completed_effect_revisions: Mapping[str, str] = field(default_factory=dict)
    inherited_checked: tuple[str, ...] = ()

    def by_id(self) -> dict[str, Step]:
        return {s.step_id: s for s in self.steps}


def _tokens(value: str) -> list[str]:
    return [x for x in re.split(r"[\s,]+", value.strip()) if x]


def parse_plan_text(text: str) -> Plan:
    project_name = ""
    project_id = ""
    raw_steps: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None
    inflight_revisions: dict[str, str] = {}
    completed_effects: dict[str, str] = {}
    completed_effect_revisions: dict[str, str] = {}
    inherited_checked: set[str] = set()
    for line in text.splitlines():
        if line.startswith("project ") and not project_name:
            project_name = line.removeprefix("project ").strip()
        elif line.startswith("id ") and not project_id:
            project_id = line.removeprefix("id ").strip()
        elif line.startswith("inflight_revision "):
            parts = line.split()
            if len(parts) != 3 or not HEX64.fullmatch(parts[2]) or parts[1] in inflight_revisions:
                raise ValueError("invalid or duplicate inflight_revision")
            inflight_revisions[parts[1]] = parts[2]
        elif line.startswith("completed_effect "):
            parts = line.split()
            if (len(parts) != 4 or not HEX64.fullmatch(parts[2])
                or not re.fullmatch(r"tf-[0-9a-f]{40}", parts[3]) or parts[1] in completed_effects):
                raise ValueError("invalid or duplicate completed_effect")
            completed_effect_revisions[parts[1]] = parts[2]
            completed_effects[parts[1]] = parts[3]
        elif line.startswith("inherited_checked "):
            parts = line.split()
            if len(parts) != 2 or parts[1] in inherited_checked:
                raise ValueError("invalid or duplicate inherited_checked")
            inherited_checked.add(parts[1])
        match = STEP_RE.match(line)
        if match:
            current = {
                "step_id": match.group("id"),
                "title": match.group("title"),
                "checked": match.group("check").lower() == "x",
                "indent": len(match.group("indent").expandtabs(4)),
                "fields": {},
            }
            raw_steps.append(current)
            continue
        field_match = FIELD_RE.match(line)
        if current and field_match and len(field_match.group("indent").expandtabs(4)) > current["indent"]:
            current["fields"][field_match.group("key")] = field_match.group("value").strip()
    if not project_id or not raw_steps:
        raise ValueError("plan must contain an id and at least one checkbox step")
    ids = {row["step_id"] for row in raw_steps}
    if len(ids) != len(raw_steps):
        raise ValueError("duplicate step id")
    if (set(inflight_revisions) | set(completed_effects) | inherited_checked) - ids:
        raise ValueError("revision metadata references an unknown step")
    stack: list[dict[str, Any]] = []
    steps: list[Step] = []
    for row in raw_steps:
        while stack and stack[-1]["indent"] >= row["indent"]:
            stack.pop()
        deps: list[str] = []
        for key in ("depends_on", "dependencies"):
            deps.extend(_tokens(row["fields"].get(key, "")))
        # A nested checkbox is ordered after its immediate parent unless it says otherwise.
        if stack and not deps:
            deps.append(stack[-1]["step_id"])
        deps = list(dict.fromkeys(deps))
        missing = [d for d in deps if d not in ids]
        if missing:
            raise ValueError(f"step {row['step_id']} references missing dependencies: {missing}")
        steps.append(Step(row["step_id"], row["title"], row["checked"], row["indent"], dict(row["fields"]), tuple(deps)))
        stack.append(row)
    graph = {s.step_id: set(s.dependencies) for s in steps}
    temporary: set[str] = set()
    permanent: set[str] = set()
    def visit(node: str) -> None:
        if node in permanent: return
        if node in temporary: raise ValueError(f"dependency cycle at {node}")
        temporary.add(node)
        for dep in graph[node]: visit(dep)
        temporary.remove(node); permanent.add(node)
    for node in graph: visit(node)
    if set(inflight_revisions) & set(completed_effects):
        raise ValueError("step cannot be inflight and complete")
    if any(row["checked"] and row["step_id"] in inflight_revisions for row in raw_steps):
        raise ValueError("checked step cannot be inflight")
    if any(not row["checked"] and row["step_id"] in completed_effects for row in raw_steps):
        raise ValueError("completed_effect requires a checked step")
    if inherited_checked & set(completed_effects):
        raise ValueError("inherited and verified checkoff overlap")
    if any(jid != stable_id(project_id, completed_effect_revisions[step_id], step_id, "external_effect", "0")
           for step_id, jid in completed_effects.items()):
        raise ValueError("completed_effect job ID does not match its source revision")
    if any(not row["checked"] and row["step_id"] in inherited_checked for row in raw_steps):
        raise ValueError("inherited_checked requires a checked step")
    if (inflight_revisions or completed_effects or inherited_checked) and any(
        row["checked"] and row["step_id"] not in completed_effects and row["step_id"] not in inherited_checked
        for row in raw_steps
    ):
        raise ValueError("checked step lacks verified effect or explicit inherited baseline")
    return Plan(project_id, project_name or project_id, sha256_bytes(text.encode()), text, tuple(steps),
                inflight_revisions=inflight_revisions, completed_effects=completed_effects,
                completed_effect_revisions=completed_effect_revisions,
                inherited_checked=tuple(sorted(inherited_checked)))


def parse_plan(path: Path) -> Plan:
    path = path.resolve(strict=True)
    raw = path.read_bytes()
    plan = parse_plan_text(raw.decode("utf-8"))
    return replace(plan, sha256=sha256_bytes(raw), source_ref="file:" + str(path))


def plan_revision_path(path: Path, revision: str) -> Path:
    if not HEX64.fullmatch(revision):
        raise ValueError("invalid prior plan revision")
    return path.parent / ".taskflow-plan-revisions" / path.name / f"{revision}.plan"


def prior_plan_cohorts(plan: Plan) -> list[tuple[Plan, set[str]]]:
    """Resume already-started work from the committed plan bytes that created it."""
    source = Path(plan.source_ref.removeprefix("file:"))
    cohorts: list[tuple[Plan, set[str]]] = []
    for revision in sorted(set(plan.inflight_revisions.values())):
        old = parse_plan(plan_revision_path(source, revision))
        verify_plan_revision(old)
        if old.sha256 != revision or old.project_id != plan.project_id:
            raise ValueError("prior plan snapshot does not match its revision/project")
        ids = {step_id for step_id, value in plan.inflight_revisions.items() if value == revision}
        if not ids <= old.by_id().keys():
            raise ValueError("prior plan snapshot is missing an in-flight step")
        cohorts.append((old, ids))
    return cohorts


def verify_plan_revision(plan: Plan) -> None:
    if not HEX64.fullmatch(plan.sha256):
        raise ValueError("invalid plan revision")
    if sha256_bytes(plan.text.encode("utf-8")) != plan.sha256:
        raise ValueError("plan text differs from immutable revision")
    if not plan.source_ref.startswith("file:"):
        raise ValueError("plan_source_ref must identify the source file")
    source = Path(plan.source_ref.removeprefix("file:"))
    if sha256_file(source) != plan.sha256:
        raise ValueError("plan source changed since parsing")
    root = subprocess.run(["git", "-C", str(source.parent), "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True, timeout=10, check=False)
    if root.returncode == 0:
        repo = Path(root.stdout.strip()).resolve()
        relative = source.resolve().relative_to(repo).as_posix()
        committed = subprocess.run(["git", "-C", str(repo), "show", f"HEAD:{relative}"],
                                   capture_output=True, timeout=10, check=False)
        if committed.returncode != 0 or sha256_bytes(committed.stdout) != plan.sha256:
            raise ValueError("plan revision is not the committed project instruction")


def phase_job_id(plan: Plan, step_id: str, phase: str, attempt: int = 0) -> str:
    return stable_id(plan.project_id, plan.inflight_revisions.get(step_id, plan.sha256), step_id, phase, str(attempt))


MAX_CHAT_NATIVE_ATTEMPTS = 3  # One original turn and at most two corrective turns.


class NativeEvidenceMissing(ValueError):
    """A definitive completed Chat-mode turn had no provider-observed native execution."""


def final_dependency_ids(plan: Plan, step: Step) -> list[str]:
    by_id = plan.by_id()
    inherited = [dep for dep in step.dependencies if by_id[dep].checked and dep not in plan.completed_effects]
    if inherited:
        raise ValueError(f"checked dependency lacks a D1-verified external effect: {', '.join(inherited)}")
    return [plan.completed_effects[dep] if by_id[dep].checked else phase_job_id(plan, dep, "external_effect")
            for dep in step.dependencies]


def safe_zip_members(path: Path) -> list[zipfile.ZipInfo]:
    if not path.is_file() or path.stat().st_size <= 0 or path.stat().st_size > MAX_ZIP_BYTES:
        raise ValueError("ZIP missing/empty/too large")
    if not zipfile.is_zipfile(path):
        raise ValueError("not a ZIP")
    total = 0
    with zipfile.ZipFile(path) as archive:
        infos = archive.infolist()
        if not infos or len(infos) > MAX_ZIP_MEMBERS:
            raise ValueError("invalid ZIP member count")
        for info in infos:
            p = PurePosixPath(info.filename)
            if p.is_absolute() or ".." in p.parts or "\\" in info.filename:
                raise ValueError("unsafe ZIP member path")
            # Unix symlink file type.
            if (info.external_attr >> 16) & 0o170000 == 0o120000:
                raise ValueError("symlink in ZIP")
            total += info.file_size
            if total > MAX_EXPANDED_BYTES:
                raise ValueError("ZIP expanded size too large")
        return infos


def verify_manifest_zip(path: Path, *, expected_plan_sha256: str | None = None, require_external_instructions: bool = False) -> dict[str, Any]:
    infos = safe_zip_members(path)
    names = {i.filename for i in infos if not i.is_dir()}
    if len(names) != len([i for i in infos if not i.is_dir()]):
        raise ValueError("duplicate ZIP member path")
    manifest_name = next((n for n in ("MANIFEST.json", "manifest.json", "MANIFEST.sha256.json") if n in names), None)
    if not manifest_name:
        raise ValueError("ZIP lacks top-level manifest JSON")
    if require_external_instructions and "EXTERNAL_EFFECT_INSTRUCTIONS.md" not in names:
        raise ValueError("work ZIP lacks top-level EXTERNAL_EFFECT_INSTRUCTIONS.md")
    with zipfile.ZipFile(path) as archive:
        manifest = json.loads(archive.read(manifest_name))
        if not isinstance(manifest, dict):
            raise ValueError("manifest must be an object")
        manifest_plan = str(manifest.get("plan_sha256") or "").lower()
        if expected_plan_sha256 and manifest_plan != expected_plan_sha256.lower():
            raise ValueError("manifest plan_sha256 mismatch")
        rows = manifest.get("files")
        if not isinstance(rows, list) or not rows:
            raise ValueError("manifest files must be non-empty list")
        seen: set[str] = set()
        for row in rows:
            if not isinstance(row, dict): raise ValueError("bad manifest file row")
            name = str(row.get("path") or "")
            expected = str(row.get("sha256") or "").lower()
            if not name or name in seen or name not in names or not HEX64.match(expected):
                raise ValueError("manifest entry invalid")
            if name == manifest_name:
                raise ValueError("manifest must not self-hash")
            actual = sha256_bytes(archive.read(name))
            if actual != expected: raise ValueError(f"manifest hash mismatch: {name}")
            seen.add(name)
        unhashed = names - seen - {manifest_name}
        if unhashed:
            raise ValueError(f"unmanifested ZIP members: {sorted(unhashed)[:5]}")
        instructions_sha = None
        if require_external_instructions:
            instructions_sha = sha256_bytes(archive.read("EXTERNAL_EFFECT_INSTRUCTIONS.md"))
    return {
        "path": str(path), "sha256": sha256_file(path), "size": path.stat().st_size,
        "manifest_name": manifest_name, "manifest_sha256": sha256_bytes(json.dumps(manifest, sort_keys=True, separators=(",", ":")).encode()),
        "member_count": len(names), "instructions_sha256": instructions_sha,
    }


class QueueClient:
    def __init__(self, sender_module: Any): self.sender = sender_module
    def post(self, body: dict[str, Any]) -> dict[str, Any]:
        reply = self.sender.operator_memory_post(body)
        if not isinstance(reply, dict): raise RuntimeError("D1 API returned non-object")
        return reply
    def get(self, job_id: str) -> dict[str, Any] | None:
        try:
            reply = self.post({"operation":"get_job","job_id":job_id})
        except Exception as exc:
            cause = exc.__cause__
            if isinstance(cause, urllib.error.HTTPError) and cause.code == 404 and "job_not_found" in str(exc):
                return None
            raise
        if reply.get("error") == "job_not_found": return None
        if not reply.get("ok") or not isinstance(reply.get("job"), dict):
            raise RuntimeError(f"D1 get_job failed: {reply.get('error') or reply}")
        job = reply["job"]
        if str(job.get("id")) != job_id:
            raise RuntimeError("D1 get_job returned a different job")
        return job
    def enqueue(self, job: dict[str, Any]) -> dict[str, Any]:
        body = {**job, "operation":"enqueue_job", "job_id":job["id"],
                "prompt_authority":"taskflow_plan", "source":"taskflow-phase-controller"}
        reply = self.post(body)
        if not reply.get("ok") and not reply.get("job"):
            raise RuntimeError(f"D1 enqueue failed: {reply.get('error') or reply}")
        saved = reply.get("job")
        if not isinstance(saved, dict) or saved.get("id") != job["id"]:
            raise RuntimeError("D1 enqueue did not return the exact job")
        proof = saved.get("taskflow_plan_receipt") or {}
        if (saved.get("prompt_author") != "taskflow_plan" or saved.get("provider") != job["provider"]
            or saved.get("prompt_sha256") != job["prompt_sha256"] or saved.get("plan_revision") != job["plan_revision"]
            or saved.get("assigned_employee") != job["assigned_employee"]
            or proof.get("plan_sha256") != job["plan_revision"]
            or proof.get("plan_source_ref") != job["plan_source_ref"]
            or proof.get("taskflow_step") != job["taskflow_step"]
            or proof.get("phase") != job["phase"]):
            raise RuntimeError("D1 enqueue returned a job without matching TaskFlow plan authority")
        return saved
    def claim(self, provider: str, worker_id: str, job_id: str) -> dict[str, Any] | None:
        reply = self.post({"operation":"claim_jobs","provider":provider,"worker_id":worker_id,"job_id":job_id,"limit":1})
        rows = reply.get("jobs") or []
        if not rows: return None
        job = rows[0]
        if (job.get("id") != job_id or job.get("provider") != provider or job.get("claimed_by") != worker_id
            or not job.get("lease_token") or job.get("lease_generation") is None):
            raise RuntimeError("D1 claim does not match requested job, provider, employee, or fence")
        return job
    def begin(self, job: Mapping[str, Any]) -> dict[str, Any]:
        return self.post({"operation":"begin_effect", "job_id":job["id"], "worker_id":job["claimed_by"], "lease_token":job["lease_token"], "lease_generation":job["lease_generation"]})
    def complete(self, job: Mapping[str, Any], evidence: Sequence[Mapping[str, Any]], *, conversation_id: str | None = None) -> dict[str, Any]:
        body={"operation":"complete_job","job_id":job["id"],"worker_id":job["claimed_by"],"lease_token":job["lease_token"],"lease_generation":job["lease_generation"],"effect_evidence":list(evidence)}
        if conversation_id: body["conversation_id"] = conversation_id
        return self.post(body)


def load_sender() -> Any:
    loader = importlib.machinery.SourceFileLoader("cognilode_chatmode_sender_for_taskflow", str(SENDER_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader); assert spec
    module = importlib.util.module_from_spec(spec); loader.exec_module(module)
    return module


def job_base(plan: Plan, step: Step, phase: str, *, provider: str, priority: int, dependencies: Sequence[str]) -> dict[str, Any]:
    verify_plan_revision(plan)
    now = utc()
    payload = {
        "schema":"cognilode.taskflow.phase_job.v1", "taskflow_multi_phase":True,
        "project":plan.project_id, "project_name":plan.project_name, "plan_revision":plan.sha256,
        "plan_source_ref":plan.source_ref, "plan_text_sha256":plan.sha256,
        "taskflow_step":step.step_id, "taskflow_title":step.title, "taskflow_phase":phase,
        "taskflow_dependencies":list(dependencies), "priority":priority, "phase_attempt":0,
    }
    return {
        "id":phase_job_id(plan, step.step_id, phase), "provider":provider, "state":"queued",
        "prompt":"phase placeholder", "prompt_author":"taskflow_plan",
        "prompt_sha256":sha256_bytes(b"phase placeholder"), "created_at":now, "due_at":now,
        "priority":priority, "project":plan.project_id, "plan_revision":plan.sha256,
        "plan_source_ref":plan.source_ref, "plan_text":plan.text,
        "taskflow_step":step.step_id, "phase":phase, "taskflow_multi_phase":True, "phase_attempt":0,
        "taskflow_dependencies":list(dependencies), "payload":payload,
    }


def research_prompt(plan: Plan, step: Step, role: str, out_zip: Path) -> str:
    return f"""You are the named Codex research employee for this TaskFlow step.\n{slack_role_context(role)}\nProject: {plan.project_id}\nPlan SHA-256: {plan.sha256}\nStep: {step.step_id} {step.title}\n\nRead and use the FULL plan below, not an isolated leaf. Research only; do not claim TaskFlow completion. Build a focused physically readable ZIP at exactly:\n{out_zip}\nThe ZIP must contain top-level MANIFEST.json with plan_sha256={plan.sha256!r} and a files list that SHA-256 covers every other non-directory member. Include relevant code/docs/data and a research report. Do not include secrets or credentials.\n\n--- FULL PLAN ---\n{plan.text}\n"""


def chatgpt_prompt(plan: Plan, step: Step, research_meta: Mapping[str, Any]) -> str:
    return f"""You are the ChatGPT.com chat-mode native sandbox phase for TaskFlow. Work from the physically attached research ZIP.\nProject: {plan.project_id}\nPlan SHA-256: {plan.sha256}\nStep: {step.step_id} {step.title}\nResearch ZIP SHA-256: {research_meta['sha256']}\n\nRead the full attached packet and the full plan. Perform substantive code/data work and tests in your native sandbox. Return a substantial terminal in-chat report plus exactly one downloadable ZIP. That ZIP MUST contain top-level EXTERNAL_EFFECT_INSTRUCTIONS.md and top-level MANIFEST.json whose plan_sha256 equals {plan.sha256}. The manifest must SHA-256 cover every other file. Do not claim external deployment/effects you did not perform. Provider conversation completion is only this sandbox phase; it is NOT TaskFlow step completion.\n\n--- FULL PLAN ---\n{plan.text}\n"""


def external_prompt(plan: Plan, step: Step, work_zip: Path, effect_receipt: Path, employee: str) -> str:
    return f"""You are the Codex external-effect employee assigned to apply this TaskFlow sandbox output.\n{slack_role_context(employee)}\nProject: {plan.project_id}\nPlan SHA-256: {plan.sha256}\nStep: {step.step_id} {step.title}\nWork ZIP: {work_zip}\nWork ZIP SHA-256: {sha256_file(work_zip)}\n\nRead EXTERNAL_EFFECT_INSTRUCTIONS.md inside the ZIP, reconcile with current source/deployment, apply or deploy the work, and verify the real effect. Do not mark success for code/artifact production alone. On success, atomically write JSON to exactly {effect_receipt} with schema='cognilode.taskflow.external_effect.v1', status='applied', project_id, plan_sha256, step_id, work_zip_sha256, effect_kind, non-empty effect_ref, environment, checks (non-empty list of objects with command, exit_code, and observed result), and defects (list). If the effect is failed or uncertain, write status='failed' or 'uncertain'; that MUST NOT release dependents.\n\n--- FULL PLAN ---\n{plan.text}\n"""


def codex_binary_identity(binary: str) -> tuple[str, dict[str, str]]:
    """Identify a modified release by matching its manifest to the actual binary."""
    path = Path(binary).expanduser().resolve()
    provenance = {"resolved_path": str(path), "sha256": sha256_file(path)}
    try:
        version = subprocess.run(
            [binary, "--version"], text=True, capture_output=True, timeout=10, check=False
        )
        if version.returncode == 0 and version.stdout.strip():
            provenance["reported_version"] = version.stdout.strip()[:160]
    except (OSError, subprocess.TimeoutExpired):
        pass
    manifest_path = path.parent / "manifest.json"
    if manifest_path.is_file():
        try:
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
            release_binary = path.parent / "codex"
            release_digest = sha256_file(release_binary)
            commit = manifest.get("source_commit", "")
            launcher_is_safe = (
                path.name in {"launcher", "launcher-fixed"}
                and 'readlink -f -- "$0"' in path.read_text(encoding="utf-8")
            )
            if (re.fullmatch(r"[0-9a-f]{40}", commit)
                    and manifest.get("sha256") == release_digest
                    and (path.name == "codex" or launcher_is_safe)):
                provenance["source_commit"] = commit
                provenance["release_binary_sha256"] = release_digest
                return "modified_codex", provenance
        except (OSError, ValueError, TypeError, AttributeError):
            pass
    return "installed_codex", provenance


def run_secretary(secretary: Path, prompt_path: Path, *, employee: str, manager: str, repo_path: Path, phase: str) -> dict[str, Any]:
    binary = next((p for p in (os.getenv("COGNILODE_CODEX_BIN"), str(Path.home()/".local/bin/codex-cognilode"), shutil.which("codex")) if p and Path(p).is_file() and os.access(p, os.X_OK)), None)
    if not binary:
        return {"completed":False,"error":"installed Codex executable unavailable","employee":employee,"phase":phase}
    family, provenance = codex_binary_identity(binary)
    candidate = {"name":"taskflow-installed-codex", "family":family, "mode":"workspace",
                 "can_mutate_repo":True,"has_workspace_repo":True,"can_shell":True,
                 "supports_artifact_return":True,"quota_cost":"codex","available":True,
                 "effect_capabilities":{"shell":"available","repo":"available"},
                 "metadata":{"binary":binary,"sandbox_mode":"danger-full-access" if phase == "external_effect" else "workspace-write",
                             "codex_provenance":provenance}}
    candidates_path = prompt_path.parent / "secretary_candidates.json"
    candidates_path.write_text(json.dumps([candidate],sort_keys=True,indent=2)+"\n",encoding="utf-8")
    command=[str(secretary),"dispatch","--plan-file",str(prompt_path),"--employee",employee,
             "--manager",manager,"--candidates-json",str(candidates_path),"--prefer-installed",
             "--shell","--repo-path",str(repo_path),"--max-attempts","1"]
    if phase == "external_effect": command.extend(["--external-effect","shell"])
    command.append("Execute this TaskFlow phase and return a terminal receipt.")
    try:
        cp=subprocess.run(command,text=True,capture_output=True,timeout=int(os.getenv("COGNILODE_TASKFLOW_CODEX_TIMEOUT","3600")),check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"completed":False,"error":f"{type(exc).__name__}: {exc}","candidate":candidate}
    try: body=json.loads(cp.stdout) if cp.stdout.strip() else {}
    except json.JSONDecodeError: body={"raw_stdout":cp.stdout}
    if not isinstance(body, dict): body={"raw_stdout":cp.stdout,"error":"Secretary returned non-object JSON"}
    body.update({"returncode":cp.returncode,"stderr_tail":cp.stderr[-4000:]})
    final = body.get("final_candidate") or {}
    body["taskflow_route_verified"] = bool(cp.returncode == 0 and body.get("completed") is True and final.get("family") == family and final.get("name") == candidate["name"])
    body["taskflow_codex_provenance"] = provenance
    return body


def secretary_succeeded(receipt: Mapping[str, Any]) -> bool:
    return receipt.get("taskflow_route_verified") is True


def verify_effect_receipt(path: Path, *, plan: Plan, step: Step, work_sha256: str) -> dict[str, Any]:
    if not path.is_file(): raise ValueError("external effect receipt missing")
    body=json.loads(path.read_text(encoding="utf-8"))
    required={"schema":"cognilode.taskflow.external_effect.v1","status":"applied","project_id":plan.project_id,"plan_sha256":plan.sha256,"step_id":step.step_id,"work_zip_sha256":work_sha256}
    for key,value in required.items():
        if body.get(key) != value: raise ValueError(f"external receipt mismatch: {key}")
    kind = str(body.get("effect_kind") or "").strip().lower()
    if kind in {"zip", "artifact", "source_commit", "repository_commit", "git_commit", "commit", "source_patch", "code_patch", "file", "work_product"}:
        raise ValueError("source artifact is not an external effect")
    if not kind or not str(body.get("effect_ref") or "").strip() or not str(body.get("environment") or "").strip():
        raise ValueError("external effect receipt lacks concrete identity/environment")
    if re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", str(body["effect_ref"]), flags=re.I):
        raise ValueError("source commit/hash alone is not an external effect")
    if str(body["effect_ref"]).lower().startswith(("git:","commit:","zip:","sha256:")):
        raise ValueError("source artifact reference is not an external effect")
    checks=body.get("checks")
    if not isinstance(checks,list) or not checks: raise ValueError("external effect receipt lacks checks")
    for check in checks:
        if not isinstance(check,dict) or not str(check.get("command") or "").strip() or check.get("exit_code") != 0 or not str(check.get("result") or "").strip():
            raise ValueError("external effect check is not successful/verifiable")
    body["receipt_sha256"]=sha256_file(path)
    return body


def validate_probe_observation(step: Step, observed: str) -> str:
    expected = str(step.fields.get("effect_probe_expected") or "").strip()
    if expected:
        if observed != expected:
            raise ValueError(f"independent effect probe failed: output mismatch {observed[:200]!r}")
        return expected
    try:
        structured = json.loads(observed)
    except (json.JSONDecodeError, TypeError) as exc:
        raise ValueError("independent effect probe needs structured JSON evidence") from exc
    if not isinstance(structured, dict) or structured.get("schema") != "cognilode.effect_probe.v1" or structured.get("verified") is not True:
        raise ValueError("independent effect probe structured evidence is not verified")
    evidence = structured.get("evidence")
    if not isinstance(evidence, list) or not evidence or any(
        not isinstance(row, dict) or not str(row.get("kind") or "").strip()
        or not str(row.get("ref") or "").strip()
        or not HEX64.fullmatch(str(row.get("sha256") or "")) for row in evidence
    ):
        raise ValueError("independent effect probe needs SHA-bound evidence")
    declared_sources = structured.get("distinct_sources")
    if declared_sources is not None and (
        not isinstance(declared_sources, int) or declared_sources < 1
        or len({str(row["ref"]) for row in evidence}) < declared_sources
    ):
        raise ValueError("independent effect probe distinct source count is unsupported by its evidence")
    return "cognilode.effect_probe.v1 verified"


def verify_effect_probe(step: Step) -> dict[str, Any]:
    """Independently read the effect with a command authored in the .plan file."""
    command = str(step.fields.get("effect_probe_command") or "").strip()
    expected = str(step.fields.get("effect_probe_expected") or "").strip()
    timeout_seconds = int(step.fields.get("effect_probe_timeout_seconds") or (300 if expected else 900))
    argv = shlex.split(command)
    if not argv or not Path(argv[0]).is_absolute():
        raise ValueError("TaskFlow step needs an absolute read-only effect_probe_command")
    if not 5 <= timeout_seconds <= 1800:
        raise ValueError("effect_probe_timeout_seconds must be between 5 and 1800")
    result = subprocess.run(argv, text=True, capture_output=True, timeout=timeout_seconds, check=False)
    observed = result.stdout.strip()
    if result.returncode != 0:
        raise ValueError(f"independent effect probe failed: exit={result.returncode}, observed={observed[:200]!r}")
    expected = validate_probe_observation(step, observed)
    proof = {"command": command, "expected": expected, "observed": observed,
             "timeout_seconds": str(timeout_seconds), "verified_at": utc()}
    proof["sha256"] = sha256_bytes(json.dumps(proof, sort_keys=True).encode())
    return proof


def _artifact_from_chat_job(job: Mapping[str, Any]) -> Path | None:
    candidates=[]
    for row in job.get("effect_evidence") or job.get("effect_evidence_json") or []:
        if isinstance(row,dict) and row.get("kind") == "chatgpt_sandbox_artifact" and row.get("path"):
            candidates.append(Path(str(row["path"])))
    return candidates[0] if len(candidates)==1 else None


def verified_chat_completion(job: Mapping[str, Any], plan: Plan) -> dict[str, Any] | None:
    """Require a ZIP, central readback, and a paired provider-native tool result."""
    path = _artifact_from_chat_job(job)
    if not path:
        return None
    meta = verify_manifest_zip(path, expected_plan_sha256=plan.sha256, require_external_instructions=True)
    evidence = [e for e in job.get("effect_evidence") or [] if isinstance(e, dict)]
    matching = [e for e in evidence if e.get("kind") == "chatgpt_sandbox_artifact"
                and e.get("path") == str(path) and e.get("ref") == meta["sha256"]]
    if len(matching) != 1:
        raise ValueError("ChatGPT artifact evidence SHA mismatch")
    conversation_id = str(job.get("conversation_id") or "")
    if not conversation_id or not all(any(e.get("kind") == kind and e.get("ref") == conversation_id for e in evidence)
                                      for kind in ("provider_conversation", "central_conversation_readback")):
        raise ValueError("ChatGPT conversation lacks matching central readback evidence")
    native = [e for e in evidence if e.get("kind") in {"provider_observed_functions_exec", "provider_observed_native_exec"}
              and e.get("tool") in {"functions.exec", "container.exec", None}
              and str(e.get("ref") or "").strip() and str(e.get("call_ref") or "").strip()
              and HEX64.fullmatch(str(e.get("raw_stream_sha256") or ""))]
    if not native:
        raise NativeEvidenceMissing("ChatGPT phase lacks matched provider-observed native exec call and result")
    return meta


def verified_work_attachment(job: Mapping[str, Any], plan: Plan) -> dict[str, Any]:
    attachments=job.get("attachment_refs") or []
    if len(attachments) != 1 or not isinstance(attachments[0], dict):
        raise ValueError("external-effect job lacks one immutable work ZIP reference")
    ref=str(attachments[0].get("ref") or "")
    expected=str(attachments[0].get("sha256") or "")
    if not ref.startswith("file:") or not HEX64.fullmatch(expected):
        raise ValueError("external-effect ZIP reference invalid")
    path=Path(ref.removeprefix("file:"))
    if not path.is_file():
        path=stage_external_work_zip(attachments[0],expected)
    meta=verify_manifest_zip(path,expected_plan_sha256=plan.sha256,require_external_instructions=True)
    if meta["sha256"] != expected:
        raise ValueError("external-effect ZIP differs from queued SHA-256")
    return meta


def stage_external_work_zip(row: Mapping[str, Any], digest: str) -> Path:
    """Read a returned work ZIP on a different Codex environment by exact hash."""
    mirrors=row.get("mirrors") or []
    if not isinstance(mirrors,list) or not mirrors:
        raise ValueError("external-effect work ZIP is absent and has no private mirror")
    loader=importlib.machinery.SourceFileLoader("cognilode_taskflow_attachment_stager",str(QUEUE_WORKER_PATH))
    spec=importlib.util.spec_from_loader(loader.name,loader); assert spec
    worker=importlib.util.module_from_spec(spec); loader.exec_module(worker)
    errors=[]
    for uri in mirrors:
        try:
            return worker._stage_remote_attachment(str(uri),digest)
        except (OSError,ValueError,RuntimeError,subprocess.CalledProcessError) as exc:
            errors.append(type(exc).__name__)
    raise ValueError("external-effect work ZIP mirror staging failed: " + ",".join(errors))


def portable_attachment_ref(path: Path, digest: str) -> dict[str, Any]:
    row: dict[str, Any] = {"ref": "file:" + str(path), "sha256": digest}
    bucket = os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET", "").strip()
    if bucket:
        if not HEX64.fullmatch(digest) or not path.is_file() or path.stat().st_size > MAX_ZIP_BYTES or sha256_file(path) != digest:
            raise ValueError("invalid content-addressed TaskFlow attachment")
        aws = os.environ.get("COGNILODE_AWS_CLI") or shutil.which("aws")
        if not aws:
            raise RuntimeError("AWS CLI is required for private TaskFlow attachment mirroring")
        key = f"taskflow-artifacts/sha256/{digest}.zip"
        base = [aws, "s3api", "head-object", "--bucket", bucket, "--key", key, "--output", "json"]
        head = subprocess.run(base, capture_output=True, text=True, check=False, timeout=30)
        if head.returncode != 0:
            subprocess.run([aws, "s3api", "put-object", "--bucket", bucket, "--key", key,
                            "--body", str(path), "--server-side-encryption", "AES256",
                            "--metadata", f"sha256={digest}", "--content-type", "application/zip",
                            "--output", "json"], capture_output=True, text=True, check=True, timeout=120)
            head = subprocess.run(base, capture_output=True, text=True, check=True, timeout=30)
        metadata = json.loads(head.stdout)
        if metadata.get("ContentLength") != path.stat().st_size or (metadata.get("Metadata") or {}).get("sha256") != digest:
            raise RuntimeError("private TaskFlow attachment mirror readback mismatch")
        row["mirrors"] = [f"s3://{bucket}/{key}"]
    base = os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_MIRROR_BASE", "").strip().rstrip("/")
    if base:
        if not base.startswith("https://"):
            raise RuntimeError("COGNILODE_TASKFLOW_ATTACHMENT_MIRROR_BASE must be https://")
        row.setdefault("mirrors", []).append(base + "/" + digest.lower())
    return row


def ensure_chat_job(queue: QueueClient, plan: Plan, step: Step, research_meta: Mapping[str, Any], priority: int) -> dict[str, Any]:
    jid=phase_job_id(plan,step.step_id,"chatgpt_sandbox")
    existing=queue.get(jid)
    if existing: return existing
    prompt=chatgpt_prompt(plan,step,research_meta)
    job=job_base(plan,step,"chatgpt_sandbox",provider="chatgpt.com",priority=priority,dependencies=[])
    job.update({"prompt":prompt,"prompt_sha256":sha256_bytes(prompt.encode()),"reasoning_effort":"xhigh",
                "assigned_employee":"ChatGPT chat-mode native sandbox",
                "attachment_refs":[portable_attachment_ref(Path(research_meta["path"]), research_meta["sha256"])]})
    return queue.enqueue(job)


def ensure_native_retry_job(queue: QueueClient, plan: Plan, step: Step, original: Mapping[str, Any],
                            previous: Mapping[str, Any], attempt: int) -> dict[str, Any]:
    """Enqueue one rhythm-governed repair turn from immutable original inputs."""
    if not 1 <= attempt < MAX_CHAT_NATIVE_ATTEMPTS:
        raise ValueError("native repair attempt out of bounds")
    if previous.get("state") != "complete" or previous.get("id") != phase_job_id(plan, step.step_id, "chatgpt_sandbox", attempt - 1):
        raise ValueError("native repair predecessor is not definitively complete")
    proof = original.get("taskflow_plan_receipt") or {}
    if (original.get("id") != phase_job_id(plan, step.step_id, "chatgpt_sandbox")
        or original.get("plan_revision") != plan.sha256
        or (proof and (proof.get("plan_sha256") != plan.sha256
                       or proof.get("taskflow_step") != step.step_id
                       or proof.get("phase") != "chatgpt_sandbox"))
        or original.get("prompt_sha256") != sha256_bytes(str(original.get("prompt") or "").encode())):
        raise ValueError("original ChatGPT phase does not match immutable plan and prompt")
    original_refs = original.get("attachment_refs") or []
    if len(original_refs) != 1 or not isinstance(original_refs[0], dict) or not HEX64.fullmatch(str(original_refs[0].get("sha256") or "")):
        raise ValueError("original research ZIP reference is invalid")
    research = queue.get(phase_job_id(plan, step.step_id, "research"))
    if not research or research.get("state") != "complete" or not any(
        isinstance(e, dict) and e.get("kind") == "research_zip" and e.get("ref") == original_refs[0]["sha256"]
        for e in research.get("effect_evidence") or []
    ):
        raise ValueError("original research ZIP has no completed D1 source receipt")
    if original["prompt"] != chatgpt_prompt(plan, step, {"sha256": original_refs[0]["sha256"]}):
        raise ValueError("original ChatGPT prompt differs from the plan and research ZIP")
    jid = phase_job_id(plan, step.step_id, "chatgpt_sandbox", attempt)
    existing = queue.get(jid)
    if existing:
        if (existing.get("provider") != "chatgpt.com" or existing.get("plan_revision") != plan.sha256
            or existing.get("phase") != "chatgpt_sandbox"
            or existing.get("reason") != f"native_compute_repair_attempt:{attempt}"
            or existing.get("attachment_refs") != original_refs):
            raise ValueError("existing native repair job identity or attachment mismatch")
        return existing
    prompt = (str(original["prompt"]) + "\n\nNative execution repair: The previous completed turn supplied a ZIP, "
              "but its provider stream did not show a matched native container.exec or functions.exec call and result. "
              "Perform the substantive compute in this ChatGPT chat-mode sandbox with its native execution tool. "
              "Return a fresh single ZIP and in-chat report as instructed above.\n")
    job = job_base(plan, step, "chatgpt_sandbox", provider="chatgpt.com",
                   priority=int(original.get("priority") or 0), dependencies=[str(previous["id"])])
    job.update({"id": jid, "prompt": prompt, "prompt_sha256": sha256_bytes(prompt.encode()),
                "reasoning_effort": original.get("reasoning_effort") or "xhigh",
                "assigned_employee": original.get("assigned_employee") or "ChatGPT chat-mode native sandbox",
                "attachment_refs": json.loads(json.dumps(original_refs)), "phase_attempt": attempt,
                "reason": f"native_compute_repair_attempt:{attempt}"})
    job["payload"]["phase_attempt"] = attempt
    job["payload"]["native_repair_of"] = str(original["id"])
    return queue.enqueue(job)


def materialize_research_job(queue: QueueClient, plan: Plan, step: Step, priority: int, *, role: str, state_root: Path) -> dict[str, Any]:
    jid=phase_job_id(plan,step.step_id,"research")
    existing=queue.get(jid)
    if existing: return existing
    out_zip=state_root/plan.project_id/step.step_id/"research"/jid/"research.zip"
    prompt=research_prompt(plan,step,role,out_zip)
    job=job_base(plan,step,"research",provider="codex.research",priority=priority,dependencies=final_dependency_ids(plan,step))
    job.update({"prompt":prompt,"prompt_sha256":sha256_bytes(prompt.encode()),"assigned_employee":role,"role":role})
    return queue.enqueue(job)


def ensure_external_job(queue: QueueClient, plan: Plan, step: Step, priority: int, work: Mapping[str,Any], *, state_root: Path, external_employee: str) -> dict[str,Any]:
    jid=phase_job_id(plan,step.step_id,"external_effect")
    existing=queue.get(jid)
    if existing: return existing
    effect_receipt=state_root/plan.project_id/step.step_id/"external_effect"/jid/"EXTERNAL_EFFECT_RESULT.json"
    prompt=external_prompt(plan,step,Path(str(work["path"])),effect_receipt,external_employee)
    job=job_base(plan,step,"external_effect",provider="codex.external-effect",priority=priority,dependencies=final_dependency_ids(plan,step))
    job.update({"prompt":prompt,"prompt_sha256":sha256_bytes(prompt.encode()),"assigned_employee":external_employee,
                "attachment_refs":[portable_attachment_ref(Path(work["path"]), work["sha256"])]})
    return queue.enqueue(job)


def completed_prerequisites(queue: QueueClient, plan: Plan, step: Step) -> bool:
    if any(plan.by_id()[dep].checked and dep not in plan.completed_effects for dep in step.dependencies):
        return False
    if any(plan.by_id()[dep].checked for dep in step.dependencies):
        verify_completed_effects(queue,plan,step_ids=set(step.dependencies))
    for jid in final_dependency_ids(plan,step):
        row=queue.get(jid)
        if not row or row.get("state") != "complete" or row.get("provider") != "codex.external-effect": return False
        if not any(isinstance(e,dict) and e.get("kind")=="external_effect" and e.get("ref") for e in row.get("effect_evidence") or []): return False
    return True


def completed_effect_job(queue: QueueClient, plan: Plan, step: Step) -> dict[str, Any] | None:
    """Only the fenced D1 completion with an independent readback can check a box."""
    job_id = phase_job_id(plan, step.step_id, "external_effect")
    job = queue.get(job_id)
    if job is None or job.get("state") != "complete":
        return None
    expected_revision = plan.inflight_revisions.get(step.step_id, plan.sha256)
    payload = job.get("payload") or {}
    if (job.get("id") != job_id or job.get("provider") != "codex.external-effect"
        or (job.get("plan_revision") or payload.get("plan_revision")) != expected_revision
        or (job.get("taskflow_step") or payload.get("taskflow_step")) != step.step_id
        or (job.get("phase") or payload.get("taskflow_phase")) != "external_effect"):
        raise ValueError(f"D1 effect job identity mismatch for {step.step_id}")
    evidence = job.get("effect_evidence") or job.get("effect_evidence_json") or []
    if isinstance(evidence,str):
        try: evidence=json.loads(evidence)
        except json.JSONDecodeError as exc: raise ValueError("D1 effect evidence JSON is malformed") from exc
    if not isinstance(evidence, list):
        raise ValueError(f"D1 effect evidence is malformed for {step.step_id}")
    by_kind: dict[str, list[dict[str, Any]]] = {}
    for row in evidence:
        if isinstance(row, dict):
            by_kind.setdefault(str(row.get("kind")), []).append(row)
    effect = by_kind.get("external_effect", [])
    receipt = by_kind.get("external_effect_receipt", [])
    work = by_kind.get("chatgpt_work_zip", [])
    probes = by_kind.get("independent_effect_probe", [])
    if (len(effect), len(receipt), len(work), len(probes)) != (1, 1, 1, 1):
        raise ValueError(f"D1 effect lacks exactly one effect, receipt, work ZIP and independent probe for {step.step_id}")
    if (not str(effect[0].get("ref") or "").strip()
        or any(not HEX64.fullmatch(str(row.get("ref") or "")) for row in (receipt[0], work[0], probes[0]))
        or probes[0].get("command") != step.fields.get("effect_probe_command")
        or not str(probes[0].get("observed") or "").strip()):
        raise ValueError(f"D1 effect evidence is not hash-bound to the plan probe for {step.step_id}")
    validate_probe_observation(step,str(probes[0]["observed"]))
    return job


def plan_root_source_path(plan: Plan) -> Path:
    source=Path(plan.source_ref.removeprefix("file:"))
    if source.parent.parent.name == ".taskflow-plan-revisions":
        return source.parent.parent.parent / source.parent.name
    return source


def verify_completed_effects(queue: QueueClient, plan: Plan, *, step_ids: set[str] | None = None) -> None:
    """Read D1 and the committed source revision before honoring checked steps."""
    root_source=plan_root_source_path(plan)
    for step_id,stored_id in plan.completed_effects.items():
        if step_ids is not None and step_id not in step_ids:
            continue
        revision=plan.completed_effect_revisions.get(step_id)
        if not revision:
            raise ValueError(f"checked step has no source revision: {step_id}")
        archived=parse_plan(plan_revision_path(root_source,revision))
        verify_plan_revision(archived)
        if archived.project_id != plan.project_id or archived.sha256 != revision:
            raise ValueError(f"checked step source revision mismatch: {step_id}")
        old_step=archived.by_id().get(step_id)
        current_step=plan.by_id().get(step_id)
        if (not old_step or old_step.checked or not current_step or not current_step.checked
            or archived.inflight_revisions.get(step_id)
            or old_step.title != current_step.title
            or any(old_step.fields.get(key) != current_step.fields.get(key)
                   for key in ("done_when","effect_probe_command","effect_probe_expected"))):
            raise ValueError(f"checked step differs from its effect source: {step_id}")
        job=completed_effect_job(queue,archived,old_step)
        if not job or job["id"] != stored_id:
            raise ValueError(f"checked step has no matching D1 external effect: {step_id}")


def _git(repo: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(["git", "-C", str(repo), *args], text=True, capture_output=True, timeout=30, check=False)
    if check and result.returncode:
        raise RuntimeError(f"git {' '.join(args[:2])} failed: {result.stderr.strip()[:300]}")
    return result


def plan_repo(path: Path) -> Path:
    return Path(_git(path.parent, "rev-parse", "--show-toplevel").stdout.strip()).resolve()


def execution_repo(path: Path) -> Path:
    # A plan fixture can live outside Git; checkoff itself still requires Git.
    root = _git(path.parent, "rev-parse", "--show-toplevel", check=False)
    return Path(root.stdout.strip()).resolve() if root.returncode == 0 else path.parent.parent


def _revised_plan_text(plan: Plan, *, completed: Mapping[str, str], completed_revisions: Mapping[str, str],
                       inflight: Mapping[str, str], inherited: Sequence[str]) -> str:
    lines = []
    inserted = False
    for line in plan.text.splitlines(keepends=True):
        if line.startswith(("inflight_revision ", "completed_effect ", "inherited_checked ")):
            continue
        match = STEP_RE.match(line.rstrip("\r\n"))
        if match and match.group("id") in completed and match.group("check") == " ":
            line = line[:len(match.group("indent"))] + "[x]" + line[len(match.group("indent")) + 3:]
        lines.append(line)
        if line.startswith("id ") and not inserted:
            ending = "\r\n" if line.endswith("\r\n") else "\n"
            lines.extend(f"completed_effect {key} {completed_revisions[key]} {value}{ending}"
                         for key, value in sorted(completed.items()))
            lines.extend(f"inflight_revision {key} {value}{ending}" for key, value in sorted(inflight.items()))
            lines.extend(f"inherited_checked {key}{ending}" for key in sorted(inherited))
            inserted = True
    if not inserted:
        raise ValueError("plan has no id line")
    return "".join(lines)


def checkoff_verified_effects(queue: QueueClient, plan: Plan, *, expected_revision: str,
                              expected_job_id: str, step_id: str) -> dict[str, Any]:
    """Codex employee calls this after D1 effect completion, with a revision/job fence.

    All current-revision in-flight siblings are retained under their original
    committed plan snapshot. A dependent step keeps the old D1 effect job ID
    until the sibling itself is checked off.
    """
    if plan.sha256 != expected_revision or not HEX64.fullmatch(expected_revision):
        raise ValueError("plan revision changed before checkoff")
    verify_plan_revision(plan)
    step = plan.by_id().get(step_id)
    if not step or step.checked:
        raise ValueError("checkoff target must be an unchecked plan step")
    if phase_job_id(plan, step_id, "external_effect") != expected_job_id:
        raise ValueError("external effect job fence mismatch")
    if not completed_effect_job(queue, plan, step):
        raise ValueError("D1 external effect is not complete with independent readback")
    verify_completed_effects(queue, plan)
    source = Path(plan.source_ref.removeprefix("file:"))
    repo = plan_repo(source)
    relative = source.relative_to(repo).as_posix()
    if _git(repo, "status", "--porcelain", "--", relative).stdout.strip():
        raise ValueError("plan path has uncommitted changes")
    completed = dict(plan.completed_effects)
    completed_revisions = dict(plan.completed_effect_revisions)
    inflight = dict(plan.inflight_revisions)
    newly_checked: list[str] = []
    for candidate in plan.steps:
        if candidate.checked:
            continue
        job = completed_effect_job(queue, plan, candidate)
        if job:
            completed[candidate.step_id] = str(job["id"])
            completed_revisions[candidate.step_id] = plan.inflight_revisions.get(candidate.step_id,plan.sha256)
            inflight.pop(candidate.step_id, None)
            newly_checked.append(candidate.step_id)
            continue
        # Existing phase jobs retain their originating revision across this edit.
        for phase in ("research", "chatgpt_sandbox", "external_effect"):
            existing = queue.get(phase_job_id(plan, candidate.step_id, phase))
            if existing:
                revision = plan.inflight_revisions.get(candidate.step_id, plan.sha256)
                payload = existing.get("payload") or {}
                if ((existing.get("plan_revision") or payload.get("plan_revision")) != revision
                    or (existing.get("taskflow_step") or payload.get("taskflow_step")) != candidate.step_id):
                    raise ValueError(f"phase job identity mismatch for {candidate.step_id}")
                inflight[candidate.step_id] = revision
    if step_id not in newly_checked:
        raise ValueError("target effect did not qualify for checkoff")
    inherited = set(plan.inherited_checked) | {candidate.step_id for candidate in plan.steps
                                                 if candidate.checked and candidate.step_id not in completed}
    updated = _revised_plan_text(plan, completed=completed, completed_revisions=completed_revisions,
                                 inflight=inflight, inherited=inherited)
    parsed = parse_plan_text(updated)
    if not parsed.by_id()[step_id].checked:
        raise ValueError("checkoff did not update target")
    snapshot = plan_revision_path(source, plan.sha256)
    snapshot_rel = snapshot.relative_to(repo).as_posix()
    created_snapshot = not snapshot.exists()
    if snapshot.exists() and sha256_file(snapshot) != plan.sha256:
        raise ValueError("prior plan snapshot path has different bytes")
    if _git(repo, "status", "--porcelain", "--", snapshot_rel).stdout.strip():
        raise ValueError("prior plan snapshot has uncommitted changes")
    head_before = _git(repo, "rev-parse", "HEAD").stdout.strip()
    if sha256_file(source) != plan.sha256:
        raise ValueError("plan changed before checkoff write")
    snapshot.parent.mkdir(parents=True, exist_ok=True)
    if created_snapshot:
        snapshot.write_bytes(source.read_bytes())
    new_bytes = updated.encode("utf-8")
    commit_created = False
    try:
        tmp = source.with_name(source.name + ".checkoff.tmp")
        tmp.write_bytes(new_bytes)
        tmp.replace(source)
        if _git(repo, "rev-parse", "HEAD").stdout.strip() != head_before:
            raise ValueError("repository HEAD moved during checkoff")
        _git(repo, "add", "--", relative, snapshot_rel)
        _git(repo, "-c", "user.name=TaskFlow Codex Employee", "-c", "user.email=taskflow@cognilode.local",
             "commit", "--only", "-m", f"Check off verified TaskFlow effect {step_id}", "--", relative, snapshot_rel)
        commit_created = True
        committed = parse_plan(source)
        verify_plan_revision(committed)
        if sha256_file(snapshot) != plan.sha256:
            raise ValueError("committed prior plan snapshot changed")
    except Exception as exc:
        head_now = _git(repo, "rev-parse", "HEAD", check=False)
        # A commit may have succeeded even if a later verification or wrapper
        # failed. Never restore old bytes over the committed plan in that case.
        if commit_created or head_now.returncode or head_now.stdout.strip() != head_before:
            raise RuntimeError("TaskFlow checkoff commit may exist; committed plan and snapshot left intact for recovery") from exc
        if not source.exists() or source.read_bytes() != new_bytes:
            raise RuntimeError("TaskFlow checkoff failed before commit, but plan changed concurrently; left intact") from exc
        restore=source.with_name(source.name+".checkoff.restore.tmp")
        restore.write_bytes(plan.text.encode("utf-8"))
        restore.replace(source)
        _git(repo, "reset", "-q", "--", relative, snapshot_rel, check=False)
        if created_snapshot and snapshot.exists() and sha256_file(snapshot) == plan.sha256:
            snapshot.unlink()
        raise
    return {"schema": "cognilode.taskflow.checkoff.v1", "project": plan.project_id,
            "previous_revision": plan.sha256, "new_revision": committed.sha256,
            "checked_steps": newly_checked, "effect_job_id": expected_job_id,
            "inflight_revisions": inflight, "git_commit": _git(repo, "rev-parse", "HEAD").stdout.strip()}


def run_once(*, queue: QueueClient, plan: Plan, role: str, secretary: Path, state_root: Path, worker_id: str, manager: str, priority: int, external_employee: str, seed_step: str | None = None, active_step_ids: set[str] | None = None) -> dict[str,Any]:
    verify_plan_revision(plan)
    verify_completed_effects(queue,plan)
    repo_path = execution_repo(Path(plan.source_ref.removeprefix("file:")))
    state_root.mkdir(parents=True,exist_ok=True)
    action={"at":utc(),"project":plan.project_id,"plan_sha256":plan.sha256,"actions":[]}
    def active(step: Step) -> bool:
        return ((active_step_ids is None or step.step_id in active_step_ids) and not step.checked
                and completed_prerequisites(queue,plan,step))
    def phase_jobs(phase: str, provider: str, state: str) -> Iterable[dict[str, Any]]:
        # The D1 queue is global. A limited list page can omit this project
        # indefinitely when other projects have more than one page of work.
        for candidate in plan.steps:
            if not active(candidate):
                continue
            jid=phase_job_id(plan,candidate.step_id,phase)
            row=queue.get(jid)
            if not row:
                continue
            payload=row.get("payload") or {}
            if (row.get("id") != jid or row.get("provider") != provider
                or (row.get("plan_revision") or payload.get("plan_revision")) != plan.sha256
                or (row.get("taskflow_step") or payload.get("taskflow_step")) != candidate.step_id
                or (row.get("phase") or payload.get("taskflow_phase")) != phase):
                raise ValueError(f"D1 exact phase job identity mismatch: {candidate.step_id}/{phase}")
            if row.get("state") == state:
                yield row
    # Materialize only newly dependency-eligible unchecked steps. Checked plan steps are inherited.
    if seed_step and seed_step not in plan.by_id():
        raise ValueError(f"unknown seed step: {seed_step}")
    for step in plan.steps:
        if seed_step and step.step_id != seed_step: continue
        if not active(step): continue
        owner=step.fields.get("owner") or role
        slack_role_context(owner)
        rjob=materialize_research_job(queue,plan,step,priority,role=owner,state_root=state_root)
        action["actions"].append({"step":step.step_id,"phase":"research","state":rjob.get("state"),"employee":owner})
    # Reconcile research actions that crossed begin_effect before a crash/timeout. Never resend them.
    for pending in phase_jobs("research","codex.research","effect_pending"):
        payload=pending.get("payload") or {}
        if (pending.get("plan_revision") or payload.get("plan_revision")) != plan.sha256: continue
        step=plan.by_id().get(str(pending.get("taskflow_step") or payload.get("taskflow_step")))
        if not step or not active(step): continue
        run_dir=state_root/plan.project_id/step.step_id/"research"/str(pending["id"]); out_zip=run_dir/"research.zip"
        try:
            owner=step.fields.get("owner") or role
            if pending.get("claimed_by") != owner or pending.get("assigned_employee") != owner:
                raise ValueError("research employee fence mismatch")
            receipt_path=run_dir/"secretary_receipt.json"
            if not secretary_succeeded(json.loads(receipt_path.read_text(encoding="utf-8"))):
                raise ValueError("Codex invocation was not verified")
            meta=verify_manifest_zip(out_zip,expected_plan_sha256=plan.sha256)
        except Exception:
            action["actions"].append({"step":step.step_id,"phase":"research_reconcile","ok":False,"state":"awaiting_readback"}); continue
        evidence=[{"kind":"research_zip","ref":meta["sha256"],"path":meta["path"]}]
        evidence.append({"kind":"research_invocation","ref":sha256_file(receipt_path),"path":str(receipt_path)})
        done=queue.complete(pending,evidence)
        committed=queue.get(str(pending["id"])) if done.get("ok") else None
        readback_ok=bool(committed and committed.get("state")=="complete" and any(e.get("kind")=="research_zip" and e.get("ref")==meta["sha256"] for e in committed.get("effect_evidence") or [] if isinstance(e,dict)))
        if readback_ok: ensure_chat_job(queue,plan,step,meta,priority)
        action["actions"].append({"step":step.step_id,"phase":"research_reconcile","ok":readback_ok,"zip":meta["sha256"]})

    # Research workers are generic D1 claims; this controller is their actuator.
    rjob=None
    for candidate_step in plan.steps:
        if not active(candidate_step) or (seed_step and candidate_step.step_id != seed_step): continue
        candidate_role=candidate_step.fields.get("owner") or role
        rjob=queue.claim("codex.research",candidate_role,phase_job_id(plan,candidate_step.step_id,"research"))
        if rjob:
            role=candidate_role
            break
    if rjob:
        step=plan.by_id().get(str(rjob.get("taskflow_step") or (rjob.get("payload") or {}).get("taskflow_step")))
        if step and rjob.get("id") == phase_job_id(plan,step.step_id,"research") and rjob.get("plan_revision") == plan.sha256 and rjob.get("assigned_employee") == role:
            begun=queue.begin(rjob)
            if begun.get("ok"):
                run_dir=state_root/plan.project_id/step.step_id/"research"/rjob["id"]
                run_dir.mkdir(parents=True,exist_ok=True)
                out_zip=run_dir/"research.zip"; prompt_path=run_dir/"prompt.md"
                prompt_path.write_text(research_prompt(plan,step,role,out_zip),encoding="utf-8")
                receipt=run_secretary(secretary,prompt_path,employee=role,manager=manager,repo_path=repo_path,phase="research")
                atomic_json(run_dir/"secretary_receipt.json",receipt)
                try:
                    if not secretary_succeeded(receipt): raise ValueError("installed Codex invocation did not complete")
                    meta=verify_manifest_zip(out_zip,expected_plan_sha256=plan.sha256)
                    done=queue.complete(rjob,[{"kind":"research_zip","ref":meta["sha256"],"path":meta["path"]},{"kind":"research_invocation","ref":sha256_file(run_dir/"secretary_receipt.json")}])
                    committed=queue.get(str(rjob["id"])) if done.get("ok") else None
                    readback_ok=bool(committed and committed.get("state")=="complete" and any(e.get("kind")=="research_zip" and e.get("ref")==meta["sha256"] for e in committed.get("effect_evidence") or [] if isinstance(e,dict)))
                    if readback_ok: ensure_chat_job(queue,plan,step,meta,priority)
                    action["actions"].append({"step":step.step_id,"phase":"research_effect","ok":readback_ok,"zip":meta["sha256"]})
                except Exception as exc:
                    action["actions"].append({"step":step.step_id,"phase":"research_effect","ok":False,"error":f"{type(exc).__name__}:{exc}"})
            else:
                action["actions"].append({"step":step.step_id,"phase":"research_begin","ok":False,"error":begun.get("error") or "D1 rejected begin_effect"})
        else:
            action["actions"].append({"phase":"research_claim","ok":False,"error":"claimed job does not match plan and employee"})
    # Only a definitive completed provider turn can trigger repair; an ambiguous
    # in-flight send is never retried here. Every repair is a separate D1 job,
    # governed by the same worker and historical rhythm as the original turn.
    for step in plan.steps:
        if not active(step): continue
        original = queue.get(phase_job_id(plan, step.step_id, "chatgpt_sandbox"))
        if not original: continue
        for attempt in range(MAX_CHAT_NATIVE_ATTEMPTS):
            jid = phase_job_id(plan, step.step_id, "chatgpt_sandbox", attempt)
            cjob = original if attempt == 0 else queue.get(jid)
            if not cjob: break
            payload = cjob.get("payload") or {}
            if (cjob.get("id") != jid or cjob.get("provider") != "chatgpt.com"
                or (cjob.get("phase") or payload.get("taskflow_phase")) != "chatgpt_sandbox"
                or (cjob.get("plan_revision") or payload.get("plan_revision")) != plan.sha256
                or (cjob.get("taskflow_step") or payload.get("taskflow_step")) != step.step_id
                or (attempt and cjob.get("reason") != f"native_compute_repair_attempt:{attempt}")):
                raise ValueError(f"D1 exact ChatGPT attempt identity mismatch: {step.step_id}/{attempt}")
            if cjob.get("state") != "complete": break
            try:
                meta = verified_chat_completion(cjob, plan)
                if not meta: break
            except NativeEvidenceMissing as exc:
                if attempt + 1 < MAX_CHAT_NATIVE_ATTEMPTS:
                    try:
                        retry = ensure_native_retry_job(queue, plan, step, original, cjob, attempt + 1)
                        action["actions"].append({"step":step.step_id,"phase":"native_compute_repair",
                                                  "attempt":attempt + 1,"state":retry.get("state"),
                                                  "job_id":retry["id"]})
                        if retry.get("state") == "complete":
                            continue
                    except Exception as repair_exc:
                        action["actions"].append({"step":step.step_id,"phase":"native_compute_repair","ok":False,
                                                  "error":f"{type(repair_exc).__name__}:{repair_exc}"})
                else:
                    failure = {"schema":"cognilode.taskflow.native_compute_failure.v1","state":"terminal_failure",
                               "project":plan.project_id,"plan_sha256":plan.sha256,"step":step.step_id,
                               "attempt_job_ids":[phase_job_id(plan,step.step_id,"chatgpt_sandbox",n)
                                                  for n in range(MAX_CHAT_NATIVE_ATTEMPTS)],
                               "route":"taskflow_native_compute_failure"}
                    failure_path=state_root/plan.project_id/step.step_id/"native_compute_failure.json"
                    atomic_json(failure_path,failure)
                    action["actions"].append({"step":step.step_id,"phase":"native_compute_exhausted",
                                              "state":"terminal_failure","receipt":str(failure_path),"error":str(exc)})
                break
            except Exception as exc:
                action["actions"].append({"step":step.step_id,"phase":"chatgpt_readback","ok":False,
                                          "attempt":attempt,"error":f"{type(exc).__name__}:{exc}"})
                break
            ejob=ensure_external_job(queue,plan,step,priority,meta,state_root=state_root,external_employee=external_employee)
            action["actions"].append({"step":step.step_id,"phase":"external_effect","state":ejob.get("state"),
                                      "work_zip":meta["sha256"],"chat_attempt":attempt})
            break
    # Reconcile external effects from their durable receipt before considering a new mutation.
    for pending in phase_jobs("external_effect","codex.external-effect","effect_pending"):
        payload=pending.get("payload") or {}
        if (pending.get("plan_revision") or payload.get("plan_revision")) != plan.sha256: continue
        step=plan.by_id().get(str(pending.get("taskflow_step") or payload.get("taskflow_step")))
        if not step or not active(step): continue
        receipt_path=state_root/plan.project_id/step.step_id/"external_effect"/str(pending["id"])/"EXTERNAL_EFFECT_RESULT.json"
        try:
            if pending.get("claimed_by") != external_employee or pending.get("assigned_employee") != external_employee:
                raise ValueError("external-effect employee fence mismatch")
            invocation_path=receipt_path.with_name("secretary_receipt.json")
            if not secretary_succeeded(json.loads(invocation_path.read_text(encoding="utf-8"))):
                raise ValueError("Codex invocation was not verified")
            work=verified_work_attachment(pending,plan)
            effect=verify_effect_receipt(receipt_path,plan=plan,step=step,work_sha256=work["sha256"])
            probe=verify_effect_probe(step)
        except Exception:
            action["actions"].append({"step":step.step_id,"phase":"external_effect_reconcile","ok":False,"state":"awaiting_readback"}); continue
        evidence=[{"kind":"external_effect","ref":effect["effect_ref"],"environment":effect["environment"]},{"kind":"external_effect_receipt","ref":effect["receipt_sha256"],"path":str(receipt_path)},{"kind":"chatgpt_work_zip","ref":work["sha256"],"path":work["path"]},{"kind":"independent_effect_probe","ref":probe["sha256"],"observed":probe["observed"],"command":probe["command"]}]
        done=queue.complete(pending,evidence); committed=queue.get(str(pending["id"])) if done.get("ok") else None
        readback_ok=bool(committed and committed.get("state")=="complete")
        action["actions"].append({"step":step.step_id,"phase":"external_effect_reconcile","ok":bool(done.get("ok") and readback_ok),"central_readback_verified":readback_ok,"effect_ref":effect["effect_ref"]})

    ejob=None
    for candidate_step in plan.steps:
        if not active(candidate_step) or (seed_step and candidate_step.step_id != seed_step): continue
        ejob=queue.claim("codex.external-effect",external_employee,phase_job_id(plan,candidate_step.step_id,"external_effect"))
        if ejob: break
    if ejob:
        payload=ejob.get("payload") or {}; step=plan.by_id().get(str(ejob.get("taskflow_step") or payload.get("taskflow_step")))
        if step and ejob.get("id") == phase_job_id(plan,step.step_id,"external_effect") and ejob.get("plan_revision") == plan.sha256 and ejob.get("assigned_employee") == external_employee:
            try: work=verified_work_attachment(ejob,plan)
            except Exception as exc:
                action["actions"].append({"step":step.step_id,"phase":"external_preflight","ok":False,"error":f"{type(exc).__name__}:{exc}"}); return action
            begun=queue.begin(ejob)
            if begun.get("ok"):
                run_dir=state_root/plan.project_id/step.step_id/"external_effect"/ejob["id"]; run_dir.mkdir(parents=True,exist_ok=True)
                effect_receipt=run_dir/"EXTERNAL_EFFECT_RESULT.json"; prompt_path=run_dir/"prompt.md"
                prompt_path.write_text(external_prompt(plan,step,Path(work["path"]),effect_receipt,external_employee),encoding="utf-8")
                invocation=run_secretary(secretary,prompt_path,employee=external_employee,manager=manager,repo_path=repo_path,phase="external_effect")
                atomic_json(run_dir/"secretary_receipt.json",invocation)
                try:
                    if not secretary_succeeded(invocation): raise ValueError("installed Codex invocation did not complete")
                    effect=verify_effect_receipt(effect_receipt,plan=plan,step=step,work_sha256=work["sha256"])
                    probe=verify_effect_probe(step)
                    evidence=[{"kind":"external_effect","ref":effect["effect_ref"],"environment":effect["environment"]},{"kind":"external_effect_receipt","ref":effect["receipt_sha256"],"path":str(effect_receipt)},{"kind":"chatgpt_work_zip","ref":work["sha256"],"path":work["path"]},{"kind":"independent_effect_probe","ref":probe["sha256"],"observed":probe["observed"],"command":probe["command"]}]
                    done=queue.complete(ejob,evidence)
                    committed=queue.get(str(ejob["id"])) if done.get("ok") else None
                    readback_ok=bool(committed and committed.get("state")=="complete" and any(isinstance(e,dict) and e.get("kind")=="external_effect" and e.get("ref")==effect["effect_ref"] for e in committed.get("effect_evidence") or []))
                    action["actions"].append({"step":step.step_id,"phase":"external_effect_complete","ok":bool(done.get("ok") and readback_ok),"central_readback_verified":readback_ok,"effect_ref":effect["effect_ref"]})
                except Exception as exc:
                    action["actions"].append({"step":step.step_id,"phase":"external_effect_complete","ok":False,"error":f"{type(exc).__name__}:{exc}"})
            else:
                action["actions"].append({"step":step.step_id,"phase":"external_effect_begin","ok":False,"error":begun.get("error") or "D1 rejected begin_effect"})
        else:
            action["actions"].append({"phase":"external_effect_claim","ok":False,"error":"claimed job does not match plan and employee"})
    return action


def main(argv: Sequence[str] | None=None) -> int:
    p=argparse.ArgumentParser(); p.add_argument("--plan",required=True); p.add_argument("--role",default="")
    p.add_argument("--secretary",default=str(DEFAULT_SECRETARY)); p.add_argument("--state-root",default=""); p.add_argument("--worker-id",default="taskflow-phase-controller")
    p.add_argument("--manager",default="agent-memory-manager"); p.add_argument("--priority",type=int,default=50); p.add_argument("--external-employee",default=""); p.add_argument("--seed-step",default="")
    p.add_argument("--checkoff-only",action="store_true"); p.add_argument("--expected-plan-sha",default=""); p.add_argument("--expected-effect-job-id",default=""); p.add_argument("--step-id",default="")
    args=p.parse_args(argv); plan=parse_plan(Path(args.plan)); queue=QueueClient(load_sender())
    repo_path=plan_repo(Path(plan.source_ref.removeprefix("file:")))
    state_root=Path(args.state_root).resolve() if args.state_root else repo_path/".taskflow-state"
    state_root.mkdir(parents=True,exist_ok=True)
    lock_path=state_root/("plan-"+sha256_bytes(str(Path(args.plan).resolve()).encode())[:20]+".checkoff.lock")
    if args.checkoff_only:
        if not (args.external_employee and args.expected_plan_sha and args.expected_effect_job_id and args.step_id):
            p.error("checkoff requires external employee, expected plan SHA, effect job ID and step ID")
        with lock_path.open("a+") as lock:
            fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
            result=checkoff_verified_effects(queue,parse_plan(Path(args.plan)),expected_revision=args.expected_plan_sha,
                                             expected_job_id=args.expected_effect_job_id,step_id=args.step_id)
        print(json.dumps(result,indent=2,sort_keys=True))
        return 0
    if not args.role or not args.external_employee:
        p.error("controller requires --role and --external-employee")
    with lock_path.open("a+") as lock:
        fcntl.flock(lock.fileno(),fcntl.LOCK_SH)
        plan=parse_plan(Path(args.plan))
        result={"at":utc(),"project":plan.project_id,"plan_sha256":plan.sha256,"actions":[]}
        for older,ids in prior_plan_cohorts(plan):
            row=run_once(queue=queue,plan=older,role=args.role,secretary=Path(args.secretary),state_root=state_root,
                         worker_id=args.worker_id,manager=args.manager,priority=args.priority,
                         external_employee=args.external_employee,seed_step=args.seed_step or None,active_step_ids=ids)
            result["actions"].extend(row["actions"])
        current_ids={step.step_id for step in plan.steps if step.step_id not in plan.inflight_revisions}
        row=run_once(queue=queue,plan=plan,role=args.role,secretary=Path(args.secretary),state_root=state_root,
                     worker_id=args.worker_id,manager=args.manager,priority=args.priority,
                     external_employee=args.external_employee,seed_step=args.seed_step or None,active_step_ids=current_ids)
        result["actions"].extend(row["actions"])
    # A second Codex invocation performs the plan mutation after the controller's
    # D1 completion and independent readback. It is not inferred from a receipt.
    for step in plan.steps:
        if step.checked or (args.seed_step and step.step_id != args.seed_step):
            continue
        try:
            effect=completed_effect_job(queue,plan,step)
        except ValueError as exc:
            result["actions"].append({"step":step.step_id,"phase":"checkoff_preflight","ok":False,"error":str(exc)})
            continue
        if not effect:
            continue
        if sha256_file(Path(args.plan)) != plan.sha256:
            result["actions"].append({"step":step.step_id,"phase":"plan_checkoff_wait","reason":"plan revision advanced"})
            break
        run_dir=state_root/plan.project_id/step.step_id/"checkoff"/str(effect["id"])
        run_dir.mkdir(parents=True,exist_ok=True)
        retry_path=run_dir/"retry.json"
        retry=json.loads(retry_path.read_text(encoding="utf-8")) if retry_path.exists() else {}
        if time.time() < float(retry.get("next_due_epoch") or 0):
            result["actions"].append({"step":step.step_id,"phase":"plan_checkoff_wait","next_due_epoch":retry["next_due_epoch"]})
            break
        relative=Path(args.plan).resolve().relative_to(repo_path).as_posix()
        if _git(repo_path,"status","--porcelain","--",relative).stdout.strip():
            result["actions"].append({"step":step.step_id,"phase":"plan_checkoff_preflight","ok":False,"error":"plan path has uncommitted changes"})
            break
        prompt_path=run_dir/"prompt.md"
        command=[str(Path(__file__).resolve()),"--plan",str(Path(args.plan).resolve()),
                 "--state-root",str(state_root),"--checkoff-only","--external-employee",args.external_employee,
                 "--expected-plan-sha",plan.sha256,"--expected-effect-job-id",str(effect["id"]),"--step-id",step.step_id]
        prompt_path.write_text(f"You are {args.external_employee}, the Codex external-effect employee. D1 has completed and independently verified TaskFlow step {step.step_id}. Run this exact fenced command to check off the committed .plan file and preserve in-flight siblings:\n\n{shlex.join(command)}\n\nReport the command's JSON result. Do not edit the .plan file by hand.\n",encoding="utf-8")
        invocation=run_secretary(Path(args.secretary),prompt_path,employee=args.external_employee,
                                 manager=args.manager,repo_path=repo_path,phase="external_effect")
        atomic_json(run_dir/"secretary_receipt.json",invocation)
        refreshed=parse_plan(Path(args.plan))
        ok=bool(secretary_succeeded(invocation) and refreshed.sha256 != plan.sha256
                and refreshed.by_id()[step.step_id].checked
                and refreshed.completed_effects.get(step.step_id)==effect["id"])
        if not ok:
            attempts=min(int(retry.get("attempts") or 0)+1,20)
            atomic_json(retry_path,{"attempts":attempts,"next_due_epoch":time.time()+min(3600,300*3**min(attempts-1,4)),
                                    "effect_job_id":effect["id"],"plan_revision":plan.sha256})
        result["actions"].append({"step":step.step_id,"phase":"plan_checkoff","ok":ok,
                                  "previous_revision":plan.sha256,"new_revision":refreshed.sha256 if ok else None})
        break
    print(json.dumps(result,indent=2,sort_keys=True))
    return 1 if any(row.get("ok") is False for row in result["actions"]) else 0

if __name__ == "__main__": raise SystemExit(main())
